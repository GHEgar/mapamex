ENV=develop|testing|production

POSTGRES_USER=<database_user>
POSTGRES_PASSWORD=<generate_with_make_setup>
POSTGRES_DB=name

POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=2333MB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
POSTGRES_IDLE_TX_TIMEOUT=300s
POSTGRES_STATEMENT_TIMEOUT=0

AO_ENDPOINT=https://your-storage-endpoint.com

VISOR_AO_BUCKET=visor
VISOR_AO_ACCESS_KEY=<visor_user_access_key>
VISOR_AO_SECRET_KEY=<visor_user_secret_key>

PG_PRIMARY_PORT=port
POSTGRES_PRIMARY_DATA=./volumes/postgres-primary
PG_BIND_ADDRESS=127.0.0.1
PGDATA=/path/data
BACKUP_DATA=./volumes/backups
BACKUP_UID=1000
BACKUP_GID=1000

ALLOWED_HOSTS="1.0.2.3/32 1.1.1.0/24"

CRON_SCHEDULE=hour:minute


BACKUP_DBS="db1 db2"
