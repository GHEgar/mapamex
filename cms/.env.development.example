COMPOSE_PROJECT_NAME=cms-dev
ENVIRONMENT=development

API_PORT=<port>
ADMIN_PORT=<port>

POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<db_name>

DATABASE_GIS_URL=postgresql://<user>:<password>@<database_host>:<port>/<db_name>
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=1
DATABASE_CONNECT_TIMEOUT=3
DATABASE_POOL_RECYCLE=1800

GEOSERVER_URL=http://<geoserver_host>:<port>/geoserver/
GEOSERVER_USER=<user>
GEOSERVER_PASSWORD=<password>

STORAGE_ENDPOINT=<storage_host>:<port>
STORAGE_PUBLIC_ENDPOINT=<storage_public_host>:<port>
STORAGE_USE_SSL=false
STORAGE_VERIFY_SSL=false

STORAGE_VISOR_ACCESS_KEY=visor-user
STORAGE_VISOR_SECRET_KEY=
STORAGE_CMS_ACCESS_KEY=cms-user
STORAGE_CMS_SECRET_KEY=
STORAGE_MAPAMEX_ACCESS_KEY=mapamex-user
STORAGE_MAPAMEX_SECRET_KEY=

SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>
CSRF_SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>
REFRESH_COOKIE_NAME=refresh_token
REFRESH_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=["http://<host>:<admin_port>","http://<host>:<portal_port>"]

ADMIN_USERNAME=<admin_username>
ADMIN_PASSWORD=<admin_password>
ADMIN_EMAIL=<admin_email>

CREATE_SAMPLE_USERS=true
SAMPLE_EDITORA_PASSWORD=<password>
SAMPLE_DISENADORA_PASSWORD=<password>

VITE_VISOR_PROXY_URL=http://<visor_frontend_host>:<port>

VISOR_BACKEND_URL=http://<visor_backend_host>:<port>
VISOR_INTERNAL_TOKEN=<genera_con_secrets.token_urlsafe(32)>

DISCORD_WEBHOOK_VISOR=


VITE_ADMIN_API_URL=http://<api_host>:<port>/api/administrador
VITE_WEB_URL=http://<host>:<portal_port>
