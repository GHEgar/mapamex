ENVIRONMENT=production
API_ENV_FILE=./.env.production
GUNICORN_WORKERS=8

POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=mapamex_cms

DATABASE_GIS_URL=postgresql://<user>:<password>@<database_host>:<port>/<db_name>?sslmode=require

# Host público del gateway: ÚNICA perilla. Cambiar al dominio real.
# GEOSERVER_URL, CORS_ORIGINS y VITE_WEB_URL se derivan de
# PUBLIC_ORIGIN en docker-compose.yml (environment: / build args). No hardcodear.
PUBLIC_ORIGIN=https://<domain>

GEOSERVER_USER=<user>
GEOSERVER_PASSWORD=<password>

STORAGE_ENDPOINT=<storage_host>:<port>
STORAGE_PUBLIC_ENDPOINT=/storage
STORAGE_USE_SSL=false
STORAGE_VERIFY_SSL=true

STORAGE_VISOR_ACCESS_KEY=visor-user
STORAGE_VISOR_SECRET_KEY=<rotada_por_init-buckets>
STORAGE_CMS_ACCESS_KEY=cms-user
STORAGE_CMS_SECRET_KEY=<rotada_por_init-buckets>
STORAGE_MAPAMEX_ACCESS_KEY=mapamex-user
STORAGE_MAPAMEX_SECRET_KEY=<rotada_por_init-buckets>

SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>
CSRF_SECRET_KEY=<genera_con_secrets.token_urlsafe(32)>

COOKIE_DOMAIN=<subdomain>
COOKIE_SAMESITE=strict

# CORS_ORIGINS se deriva de PUBLIC_ORIGIN en docker-compose.yml (no hardcodear).

ADMIN_USERNAME=<admin_username>
ADMIN_PASSWORD=<admin_password>
ADMIN_EMAIL=<admin_email>

VISOR_BACKEND_URL=http://<visor_backend_host>:<port>
VISOR_INTERNAL_TOKEN=<genera_con_secrets.token_urlsafe(32)>

DISCORD_WEBHOOK_VISOR=


# VITE_WEB_URL (build arg del admin) se deriva de PUBLIC_ORIGIN en docker-compose.yml.
