map "${SEO_ENABLED}" $seo_robots {
    "true"  "";
    default "noindex, nofollow";
}

map "${SEO_ENABLED}" $seo_block {
    "true"  0;
    default 1;
}

map $request_uri $storage_content_disposition {
    default         "";
    ~*\.(txt|xlsx)$ "attachment";
}

server {
    listen 80 default_server;
    server_name ${APP_DOMAIN} _;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${APP_DOMAIN} _;

    ssl_certificate     ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_CERTIFICATE_KEY};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    server_tokens off;
    client_max_body_size 100M;
    ignore_invalid_headers off;

    proxy_connect_timeout 60s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    include /etc/nginx/includes/security-headers.inc;
    # GTM desactivado hasta contar con ID MapaMex
    # include /etc/nginx/includes/gtm.inc;

    error_page 400 /error-pages/400.html;
    error_page 401 /error-pages/401.html;
    error_page 403 /error-pages/403.html;
    error_page 404 /error-pages/404.html;
    error_page 429 /error-pages/429.html;
    error_page 500 502 503 504 /error-pages/500.html;

    location /error-pages/ {
        alias /etc/nginx/error-pages/;
        internal;
    }

    location = /healthz {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        return 200 "ok\n";
    }

    # El visor es el sitio raiz: `/` sirve el SPA compilado dentro de la imagen.
    location / {
        limit_req zone=general burst=150 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        root /usr/share/nginx/visor;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header X-Robots-Tag $seo_robots;

        location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|otf)$ {
            try_files $uri =404;
            expires 1y;
            access_log off;
            add_header Cache-Control "public, immutable";
        }

        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header X-Robots-Tag $seo_robots;
        }

        location = /error-recovery.js {
            add_header Cache-Control "no-cache";
        }
    }

    location = /embed {
        root /usr/share/nginx/visor;
        try_files /index.html =404;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), microphone=(), camera=()" always;
        add_header Content-Security-Policy "frame-ancestors *" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /visor/embed {
        root /usr/share/nginx/visor;
        try_files /index.html =404;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), microphone=(), camera=()" always;
        add_header Content-Security-Policy "frame-ancestors *" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location ^~ /widget/ {
        limit_req zone=static burst=200 nodelay;
        alias /usr/share/nginx/visor/widget/;
        try_files $uri =404;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Access-Control-Allow-Origin "*" always;
    }

    location ^~ /visor/widget/ {
        limit_req zone=static burst=200 nodelay;
        alias /usr/share/nginx/visor/widget/;
        try_files $uri =404;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Access-Control-Allow-Origin "*" always;
    }

    location = /mcp {
        limit_req zone=mcp_req burst=20 nodelay;
        limit_conn mcp_conn 10;
        client_max_body_size 256k;
        set $visor_mcp "${VISOR_MCP_HOST}";
        proxy_pass http://$visor_mcp/mcp;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_connect_timeout 10s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_cache off;
    }

    location = /mcp/ {
        limit_req zone=mcp_req burst=20 nodelay;
        limit_conn mcp_conn 10;
        client_max_body_size 256k;
        set $visor_mcp "${VISOR_MCP_HOST}";
        proxy_pass http://$visor_mcp/mcp;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_connect_timeout 10s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_cache off;
    }

    location ^~ /api/administrador/storage/thumb {
        # Miniaturas del Storage: muchas peticiones GET por pagina pero cacheables.
        # Zona/burst propios para no chocar con el limite general del API y, sobre
        # todo, NO forzar no-store: se deja pasar el Cache-Control inmutable del
        # thumbnail para que el navegador cachee y no repita la rafaga en cada render.
        limit_req zone=storage_thumb burst=120 nodelay;
        set $portal_upstream "${PORTAL_HOST}";
        proxy_pass http://$portal_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /api/administrador/storage {
        limit_req zone=api burst=20 nodelay;
        client_max_body_size 1G;
        proxy_request_buffering off;
        set $portal_upstream "${PORTAL_HOST}";
        proxy_pass http://$portal_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        set $portal_upstream "${PORTAL_HOST}";
        proxy_pass http://$portal_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        add_header Cache-Control "no-store" always;
    }

    location /administrador/ {
        limit_req zone=general burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        set $portal_upstream "${PORTAL_HOST}";
        proxy_pass http://$portal_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_set_header Accept-Encoding "";
        proxy_intercept_errors on;
    }

    # Admin-only: cms los invoca via mapamex-network directo al backend,
    # no deben ser alcanzables desde internet.
    location = /visor/api/layers/refresh-cache {
        return 403;
    }

    location = /visor/api/layers/invalidate-cache {
        return 403;
    }

    location ^~ /visor/assets/ {
        limit_req zone=static burst=200 nodelay;
        alias /usr/share/nginx/visor/assets/;
        try_files $uri =404;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /visor/api/download/ {
        limit_req zone=api burst=5 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        set $visor_backend "${VISOR_BACKEND_HOST}";
        rewrite ^/visor/api/(.*) /$1 break;
        proxy_pass http://$visor_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_connect_timeout 10s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    location = /visor/mcp {
        limit_req zone=mcp_req burst=20 nodelay;
        limit_conn mcp_conn 10;
        client_max_body_size 256k;
        set $visor_mcp "${VISOR_MCP_HOST}";
        proxy_pass http://$visor_mcp/mcp;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_connect_timeout 10s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_cache off;
    }

    location = /visor/mcp/ {
        limit_req zone=mcp_req burst=20 nodelay;
        limit_conn mcp_conn 10;
        client_max_body_size 256k;
        set $visor_mcp "${VISOR_MCP_HOST}";
        proxy_pass http://$visor_mcp/mcp;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_connect_timeout 10s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_cache off;
    }

    location = /visor/api/metrics {
        return 403;
    }

    # Backend del visor: /visor/api/* (layers, etc.) proxea al backend, NO redirige.
    location ^~ /visor/api/ {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/includes/bot-protection.inc;
        client_max_body_size 10M;
        set $visor_backend "${VISOR_BACKEND_HOST}";
        rewrite ^/visor/api/(.*) /$1 break;
        proxy_pass http://$visor_backend;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Compat: enlaces viejos /visor/... (SPA) redirigen a la raíz (el visor ahora vive en /).
    # Los sub-bloques ^~ /visor/api/, /visor/mcp, /visor/assets/ (prefijo más largo) siguen aplicando.
    location ^~ /visor/ {
        rewrite ^/visor/(.*)$ /$1 redirect;
    }

    location ^~ /storage/thumb/ {
        # Miniaturas publicas on-the-fly del Storage: las sirve cms-api (WebP
        # escalado), no SeaweedFS. Prefijo mas largo que /storage/ => gana el matcheo
        # ^~ y NO se reescribe el path (cms-api espera /storage/thumb/...).
        # Solo responde para buckets publicos; privados devuelven 404.
        limit_req zone=storage_thumb burst=120 nodelay;
        set $portal_upstream "${PORTAL_HOST}";
        proxy_pass http://$portal_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location ^~ /storage/ {
        limit_req zone=static burst=200 nodelay;
        client_max_body_size 1G;
        proxy_buffering off;
        proxy_request_buffering off;
        set $storage_upstream "${STORAGE_HOST}";
        rewrite ^/storage/(.*) /$1 break;
        proxy_pass http://$storage_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
        add_header Content-Disposition $storage_content_disposition always;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
        chunked_transfer_encoding off;
    }

    location ^~ /cms/assets/ {
        limit_req zone=static burst=200 nodelay;
        set $cms_upstream "${CMS_HOST}";
        proxy_pass http://$cms_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /cms/ {
        limit_req zone=general burst=20 nodelay;
        set $cms_upstream "${CMS_HOST}";
        proxy_pass http://$cms_upstream;
        include /etc/nginx/includes/proxy-params.inc;
        proxy_intercept_errors on;
    }

    include /etc/nginx/includes/geoserver-locations.inc;

    location = /robots.txt {
        if ($seo_block) {
            return 200 "User-agent: *\nDisallow: /\n";
        }
        root /usr/share/nginx/html;
        access_log off;
    }

    location = /sitemap.xml {
        if ($seo_block) {
            return 404;
        }
        root /usr/share/nginx/html;
        access_log off;
    }

    location ^~ /.well-known/ {
        root /usr/share/nginx/html;
        access_log off;
    }

    location ~ /\. {
        deny all;
    }
}
